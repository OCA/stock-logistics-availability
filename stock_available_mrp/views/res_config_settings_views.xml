<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_potential_mrp_configuration" model="ir.ui.view">
        <field
            name="name"
        >Stock settings: consider potential stock for availability </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='stock_available_mrp_based_on']/.."
                position="before"
            >
                <field name="stock_available_potential_based" class="oe_inline" />
                <label for="stock_available_potential_based" />
            </xpath>
            <xpath
                expr="//field[@name='module_stock_available_mrp']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//label[@for='module_stock_available_mrp']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='stock_available_mrp_based_on']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'invisible': [('stock_available_potential_based', '=', False)], 'required':[('module_stock_available_mrp','=',True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
