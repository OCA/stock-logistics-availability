<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="portal_my_consigned_stock_by_lots" name="My Consigned Stock by Lots">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Consigned Stock by Lots</t>
            </t>

            <t t-if="not owner">
                <div class="alert alert-warning mt-3" role="alert">
                    We were unable to identify a goods owner
                    associated with your account.
                </div>
            </t>

            <t t-else="">
                <div class="row">
                    <div class="col-12 my-3">
                        <form
                            method="get"
                            t-attf-action="/my/consigned-stock/lots/#{product_id}"
                            class="form-inline"
                        >
                        <div class="row">
                            <t t-if="warehouses and len(warehouses) &gt; 1">
                                    <div class="col-auto pt-2">
                                        <span class="mr-sm-2">Warehouse:</span>
                                    </div>
                                    <div class="d-inline col-2 px-0">
                                        <select
                                            name="warehouse_id"
                                            id="warehouse_id"
                                            class="form-control"
                                        >
                                            <option value="">All</option>
                                            <t t-foreach="warehouses" t-as="wh">
                                                <option
                                                    t-att-value="wh.id"
                                                    t-att-selected="warehouse_id and int(warehouse_id) == wh.id"
                                                >
                                                    <t t-esc="wh.name" />
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                            </t>
                            <div class="col-auto pt-2">
                                <span class="sr-only">Best Before: </span>
                            </div>
                            <div class="d-inline col-auto px-0">
                                <input
                                        class="form-control"
                                        type="date"
                                        name="date_from"
                                        t-att-value="date_from"
                                    />
                            </div>
                            <div class="col-auto px-1 pt-2">
                                <span class="sr-only">-</span>
                            </div>
                            <div class="d-inline col-auto px-0">
                                <input
                                        class="form-control"
                                        type="date"
                                        name="date_to"
                                        t-att-value="date_to"
                                    />
                            </div>
                            <div class="d-inline col-auto">
                                <button
                                        class="btn btn-primary"
                                        type="submit"
                                    >Apply</button>
                            </div>
                        </div>
                        <input type="hidden" name="search" t-att-value="search" />
                        <input type="hidden" name="search_in" t-att-value="search_in" />
                        <input type="hidden" name="sortby" t-att-value="sortby" />
                        </form>
                    </div>
                </div>
            </t>
            <t t-if="not lot_ids">
                <div class="alert alert-info mt-3" role="alert">
                    No lots associated with your
                    owner were found.
                </div>
            </t>
            <t t-else="">
                <div class="row">
                    <div class="col-12">
                        <h3 t-esc="product.display_name" />
                    </div>
                </div>
                <table class="table table-hover o_portal_my_doc_table">
                    <thead>
                        <tr class="active">
                            <th>Lot</th>
                            <th>On Hand Qty</th>
                            <th>Created</th>
                            <th>Best Before</th>
                            <th>Expiration</th>
                            <th>Removal</th>
                            <th>Alert</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lot_ids" t-as="lot">
                            <td><t t-esc="lot.name" /></td>
                            <td><t t-esc="lot.product_qty" /></td>
                            <td><t t-esc="lot.create_date" /></td>
                            <td><t t-esc="lot.use_date" /></td>
                            <td><t t-esc="lot.expiration_date" /></td>
                            <td><t t-esc="lot.removal_date" /></td>
                            <td><t t-esc="lot.alert_date" /></td>
                        </tr>
                    </tbody>
                </table>
                <div class="o_portal_pager text-center">
                    <t t-call="portal.pager" />
                </div>
            </t>
        </t>
    </template>

    <template
        id="portal_my_home_menu_consigned_stock_by_lots"
        name="Portal layout: My Consigned Stock by lots menu entry"
        inherit_id="portal.portal_breadcrumbs"
        priority="99"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'consigned_stock_by_lot'" class="breadcrumb-item">
                <a
                    t-attf-href="/my/consigned-stock?{{ keep_query() }}"
                >My Consigned Stock</a>
            </li>
            <li
                t-if="page_name == 'consigned_stock_by_lot' or lot_ids"
                class="breadcrumb-item active"
            >
                My Consigned Lots
            </li>
        </xpath>
    </template>


    <template
        id="portal_my_consigned_stock_inherit"
        name="Portal My Consigned Stock by Lots Inherit"
        inherit_id="stock_available_portal_owner.portal_my_consigned_stock"
        priority="99"
    >
        <span t-esc="product_value['product'].display_name" position="replace">
            <t
                t-set="operation_url"
                t-value="'/my/consigned-stock/lots/%s' % (product_value['product'].id)"
            />
            <a t-attf-href="{{ operation_url}}">
                <t t-out="product_value['product'].display_name" />
            </a>
        </span>
    </template>
</odoo>
