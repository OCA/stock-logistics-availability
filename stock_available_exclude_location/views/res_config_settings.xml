<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.stock (in stock_available_exclude_location)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="track_product_location" position="after">
                <setting
                    id="stock_excluded_location"
                    company_dependent="1"
                    string="Excluded Locations for Product Availability"
                    help="Selected locations and their children are excluded from product availability."
                    invisible="not group_stock_multi_locations"
                >
                    <field
                        name="stock_excluded_location_ids"
                        widget="many2many_tags"
                        domain="[('company_id', '=', company_id)]"
                        options="{'no_create': True}"
                    />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
